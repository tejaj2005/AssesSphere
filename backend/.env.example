# Vercel Deployment Backend Environment Variables
# Copy these values into your Vercel Environment Variables project settings.

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/assesssphere?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_long_random_string_min_32_chars
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

NODE_ENV=production
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# Optional AI / Upload Configs (Defaults applied if left blank)
AI_CACHE_TTL_HOURS=72
AI_CACHE_TTL_CHECKLIST_HOURS=168
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_DAILY_QUOTA=20
GEMINI_QUOTA_BUFFER=2
UPLOAD_MAX_MB=10
