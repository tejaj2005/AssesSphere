GEMINI_API_KEY=REPLACE_WITH_YOUR_NEW_GEMINI_KEY
GROQ_API_KEY=REPLACE_WITH_YOUR_NEW_GROQ_KEY
MONGODB_URI=REPLACE_WITH_YOUR_NEW_MONGODB_URI
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_e.g._openssl_rand_-hex_48
PORT=3001
NODE_ENV=development
AI_CACHE_TTL_HOURS=72
AI_CACHE_TTL_CHECKLIST_HOURS=168
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_DAILY_QUOTA=20
GEMINI_QUOTA_BUFFER=2
UPLOAD_MAX_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
