    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^11.3.19",
    "groq-sdk": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.408.0",
