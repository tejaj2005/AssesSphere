# Vercel Deployment Frontend Environment Variables
# If deployed as a single unified Vercel project, set VITE_API_URL=/api (relative path).
# If deployed as two separate Vercel projects, set VITE_API_URL to your backend's Vercel URL (e.g., https://assesssphere-backend.vercel.app/api).

VITE_API_URL=/api
VITE_AI_API_URL=/api/ai
